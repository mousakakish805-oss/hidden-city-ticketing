# ---------------------------------------------------------------------------
# Hidden-City Ticketing -- backend configuration
# Copy to `.env` and edit. Every value below is optional; the defaults run the
# app end-to-end with synthetic data and no external services.
# ---------------------------------------------------------------------------

# --- Application ---------------------------------------------------------
ENVIRONMENT=dev              # dev | prod | test
DEBUG=true
API_PREFIX=/api

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ------------------------------------------------------------
# PostgreSQL (recommended). `postgres://` and `postgresql://` are both accepted
# and upgraded to the asyncpg driver automatically.
# DATABASE_URL=postgresql://hidden_city:hidden_city@localhost:5432/hidden_city
#
# Leave unset to use a local SQLite file instead -- no database install needed.
DATABASE_URL=sqlite+aiosqlite:///./hidden_city.db
DB_ECHO=false

# --- Flight data provider -------------------------------------------------
# mock    : deterministic synthetic fares. No credentials, works offline.
# duffel  : live fares via the Duffel Flights API.
# amadeus : live fares via the Amadeus Self-Service API.
# serpapi : live fares via Google Flights, through SerpApi.
#
# Easiest way to fill these in:  python scripts/setup_provider.py serpapi
FLIGHT_PROVIDER=mock

# --- SerpApi (Google Flights) ---
# Key: https://serpapi.com/manage-api-key
# Fares are Google's published ones, so there is no sandbox to fall into.
# One user search costs MAX_CANDIDATE_DESTINATIONS + 1 searches -- no retry
# tax, because a complete result arrives first time.
SERPAPI_KEY=
SERPAPI_BASE_URL=https://serpapi.com
# Reproduces the Google Flights page exactly. Leave this on: with it off,
# AMM->JED priced the same Saudia nonstop at $146 instead of $131, and a
# traveller checking on Google -- which this site tells them to do -- finds
# the lower number. It costs no extra quota, only a slower response.
SERPAPI_DEEP_SEARCH=true

# --- RapidAPI (Air Scraper) ---
# Key:  https://rapidapi.com/developer/dashboard
# Host: the "x-rapidapi-host" shown on the listing's code snippets.
#       Sky Scrapper (Skyscanner-derived) is the listing this provider parses:
#       sky-scrapper.p.rapidapi.com
#       Unsure which you subscribed to? Run:
#         python scripts/probe_rapidapi.py --discover
#
# QUOTA WARNING: one user search costs roughly MAX_CANDIDATE_DESTINATIONS + 1
# calls. On a free tier, lower that number (see below) or you will exhaust the
# month in a few dozen searches.
RAPIDAPI_KEY=
RAPIDAPI_HOST=

# This listing returns the FIRST response as a fragment and expects you to poll
# a session for the rest. Skipping the poll is not a saving: a partial result
# set corrupts the baseline fare that every reported saving is measured
# against. Each poll is one extra call, so total cost per search is roughly
# (MAX_CANDIDATE_DESTINATIONS + 1) x (1 + RAPIDAPI_MAX_POLLS).
RAPIDAPI_MAX_POLLS=2
RAPIDAPI_POLL_DELAY_SECONDS=1.5

# --- Duffel ---
# Token: https://app.duffel.com -> Developers -> Access tokens
# duffel_test_* returns SANDBOX inventory (Duffel's own test airline).
# duffel_live_* returns real airline fares.
DUFFEL_ACCESS_TOKEN=
DUFFEL_BASE_URL=https://api.duffel.com
# Duffel changes behaviour without an explicit version header.
DUFFEL_API_VERSION=v2

# --- Amadeus ---
# Free key: https://developers.amadeus.com/ -> My Self-Service Workspace
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# Test sandbox by default. Production: https://api.amadeus.com
AMADEUS_BASE_URL=https://test.api.amadeus.com

# --- Batch engine ---------------------------------------------------------
# Each candidate is one upstream API call, so this is the main cost dial.
MAX_CANDIDATE_DESTINATIONS=12
PROVIDER_CONCURRENCY=6
PROVIDER_REQUESTS_PER_SECOND=5
PROVIDER_TIMEOUT_SECONDS=25
PROVIDER_MAX_RETRIES=2
BATCH_DEADLINE_SECONDS=90

# --- Anomaly thresholds ---------------------------------------------------
# A hidden-city option must clear BOTH to be surfaced, which filters out
# ordinary fare jitter masquerading as a saving.
MIN_SAVINGS_ABSOLUTE=15
MIN_SAVINGS_PERCENT=5
MIN_LAYOVER_MINUTES_AT_TARGET=25

# --- Candidate geometry ---------------------------------------------------
# (dist(A,B) + dist(B,C)) / dist(A,C). 1.0 = B is exactly en route to C.
# Raise to consider more distant onward markets; lower for stricter routing.
MAX_DETOUR_RATIO=1.45
MIN_ONWARD_LEG_KM=150
MAX_ONWARD_LEG_KM=4500

# --- Caching --------------------------------------------------------------
OFFER_CACHE_TTL_SECONDS=1800

# --- Scaling --------------------------------------------------------------
# Only needed to run more than one API worker: the live progress stream must
# reach a browser connected to a different worker than the one searching.
# REDIS_URL=redis://localhost:6379/0

# --- Schema ---------------------------------------------------------------
# Create missing tables at startup. Convenient locally; set false in
# production and run `alembic upgrade head` instead -- create_all cannot alter
# a table that already exists.
AUTO_CREATE_SCHEMA=true

# --- Legal ----------------------------------------------------------------
# Bump to force every user to re-read and re-accept the warning modal.
DISCLAIMER_VERSION=2026.08.2
