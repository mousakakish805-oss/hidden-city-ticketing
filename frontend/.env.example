# Where the Vite dev server proxies /api requests. Must point at the FastAPI
# backend. Only used in development -- in production, serve the built assets
# behind the same origin as the API (or set VITE_API_BASE below).
VITE_API_TARGET=http://127.0.0.1:8000

# Absolute API base URL. Leave empty to use same-origin "/api", which is what
# the dev proxy and a same-origin production deploy both want. Set it only when
# the frontend is hosted separately from the API -- and add that origin to
# CORS_ORIGINS in the backend .env if you do.
VITE_API_BASE=
